{% load static %}{
  "name": "AI Assistant",
  "short_name": "AI Assistant",
  "description": "A class assistant that explains your lessons in simple words.",
  "start_url": "{% url 'chat' %}",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#181c22",
  "theme_color": "#181c22",
  "icons": [
    {
      "src": "{% static 'assistant/icons/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png"
